include $(LIBOPENCV_BASE)/Makefile.bearuk

# For insource builds we need to preserve the sub-directory structure.
LIBOPENCV__BUILDTREE := y
LIBOPENCV_SRC := $(LIBOPENCV_BASE)

# Additional unikraft includes: opencv configure includes and intrinsics.
LIBOPENCV_CXXINCLUDES-y +=  -I$(LIBOPENCV_BASE)/unikraft-support/include

# Fall back to the compiler's includes (with intrinsics headers). The lookup
# needs to happen "after" to ensure that musl's libc headers are found first.
LIBOPENCV_CXXINCLUDES-y +=  -idirafter$(LIBOPENCV_BASE)/unikraft-support/compiler-include

# Compile cxxabi stub.
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/unikraft-support/src/cxxabi_stub.cpp
