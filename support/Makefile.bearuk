
################################################################################
# Registration
################################################################################
$(eval $(call addlib_s,libopencv,$(CONFIG_LIBOPENCV)))

################################################################################
# Flags
################################################################################
LIBOPENCV_CFLAGS-y += 
LIBOPENCV_CXXFLAGS-y +=  -DNDEBUG "-DOPENCV_ALLOCATOR_STATS_COUNTER_TYPE=long long" -D_USE_MATH_DEFINES -D__OPENCV_BUILD=1 -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS -O3 -W -Waddress -Wall -Wformat -Wformat-security -Wimplicit-fallthrough=3 -Winit-self -Wmissing-declarations -Wno-comment -Wno-delete-non-virtual-dtor -Wno-strict-overflow -Wnon-virtual-dtor -Wpointer-arith -Wreturn-type -Wsequence-point -Wshadow -Wsign-promo -Wsuggest-override -Wundef -Wuninitialized -fPIC -fdata-sections -fdiagnostics-show-option -ffunction-sections -fomit-frame-pointer -fsigned-char -fvisibility-inlines-hidden -fvisibility=hidden -isystem -msse3 -pthread -std=c++17 $(LIBOPENCV_BASE)

################################################################################
# Includes necessary to build
################################################################################
LIBOPENCV_CINCLUDES-y += 
LIBOPENCV_CXXINCLUDES-y +=  -I$(LIBOPENCV_BASE)/modules/core/ -I$(LIBOPENCV_BASE)/modules/core/include/

################################################################################
# Headers the library should export
################################################################################
CXXINCLUDES-$(CONFIG_LIBOPENCV) += -I$(LIBOPENCV_BASE)/include
CXXINCLUDES-$(CONFIG_LIBOPENCV) += -I$(LIBOPENCV_BASE)/modules/core/include
CXXINCLUDES-$(CONFIG_LIBOPENCV) += -I$(LIBOPENCV_BASE)/unikraft-support/include

################################################################################
# Sources
################################################################################
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/algorithm.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/alloc.cpp
LIBOPENCV_ALLOC_FLAGS-y +=  -DHAVE_MALLOC_H=1 -DHAVE_MEMALIGN=1 -DHAVE_POSIX_MEMALIGN=1
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/arithm.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/arithm.dispatch.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/async.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/batch_distance.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/bindings_utils.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/buffer_area.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/channels.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/check.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/command_line_parser.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_BASE)/modules/core/src/conjugate_gradient.cpp
