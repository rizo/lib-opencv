
################################################################################
# Registration
################################################################################
$(eval $(call addlib,appopencv))

################################################################################
# Flags
################################################################################
APPOPENCV_CFLAGS-y += 
APPOPENCV_CXXFLAGS-y +=  -DNDEBUG -DOPENCV_ALLOCATOR_STATS_COUNTER_TYPE="long long" -D_USE_MATH_DEFINES -D__OPENCV_BUILD=1 -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS -O3 -W -Waddress -Wall -Wformat -Wformat-security -Wimplicit-fallthrough=3 -Winit-self -Wmissing-declarations -Wno-comment -Wno-delete-non-virtual-dtor -Wno-strict-overflow -Wnon-virtual-dtor -Wpointer-arith -Wreturn-type -Wsequence-point -Wshadow -Wsign-promo -Wsuggest-override -Wundef -Wuninitialized -fPIC -fdata-sections -fdiagnostics-show-option -ffunction-sections -fomit-frame-pointer -fsigned-char -fvisibility-inlines-hidden -fvisibility=hidden -isystem -msse3 -pthread -std=c++17 $(APPOPENCV_BASE)

################################################################################
# Includes necessary to build
################################################################################
APPOPENCV_CINCLUDES-y += 
APPOPENCV_CXXINCLUDES-y +=  -I$(APPOPENCV_BASE)/modules/core/ -I$(APPOPENCV_BASE)/modules/core/include/

################################################################################
# Sources
################################################################################
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/algorithm.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/alloc.cpp
APPOPENCV_ALLOC_FLAGS-y +=  -DHAVE_MALLOC_H=1 -DHAVE_MEMALIGN=1 -DHAVE_POSIX_MEMALIGN=1
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/arithm.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/arithm.dispatch.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/async.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/batch_distance.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/bindings_utils.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/buffer_area.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/channels.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/check.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/command_line_parser.cpp
APPOPENCV_SRCS-y += $(APPOPENCV_BASE)/modules/core/src/conjugate_gradient.cpp
