LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/mathfuncs.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/mathfuncs_core.dispatch.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/matmul.dispatch.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/matrix.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/matrix_decomp.cpp
