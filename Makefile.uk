LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/matrix_operations.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/matrix_sparse.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/matrix_transform.cpp
