LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/nan_mask.dispatch.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/norm.dispatch.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/out.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/parallel.cpp
LIBOPENCV_SRCS-y += $(LIBOPENCV_SRC)/modules/core/src/parallel/parallel.cpp
