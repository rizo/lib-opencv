spec: v0.6

name: opencv

unikraft:
  version: 0.20.0
  kconfig:
    CONFIG_LIBUKBUS: 'y'
    CONFIG_LIBPOSIX_FDIO: 'y'
    CONFIG_LIBUKNETDEV_EINFO_LIBPARAM: 'y'
    CONFIG_LIBUKINTCTLR_GICV3: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBUK9P: 'y'
    CONFIG_LIB9PFS: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_UP: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT: 'y'
    CONFIG_LIBVFSCORE: 'y'
    CONFIG_LIBUKBOOT_CMDLINE_MAX_LEN: '16384'
    CONFIG_LIBUKBOOT_MAXNBARGS: '500'
    CONFIG_LIBOPENCV: 'y'

targets:
- platform: qemu
  arch: x86_64
- platform: qemu
  arch: arm64
  kconfig:
    CONFIG_MCPU_ARM64_GENERIC: 'y'
    CONFIG_LIBUKRANDOM_LCPU: 'n'

libraries:
  musl:
    version: 0.20.0
  libcxxabi:
    version: stable
  libcxx:
    source: https://github.com/Firobe/lib-libcxx.git
    version: fix-cxa
    kconfig:
      CONFIG_CXX_THREADS: 'y'
  libunwind:
    version: stable
  compiler-rt:
    version: stable
    kconfig:
      CONFIG_LIBCOMPILER_RT: 'y'

